# ---------------------------------------------------------------------------
# Modelo de configuração do ambiente de PRODUÇÃO
#
# 1) Copie este arquivo:            cp .env.prod.example .env.prod
# 2) Preencha os valores vazios (os já preenchidos são padrões seguros)
# 3) Suba a stack:
#      docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# O `--env-file .env.prod` é obrigatório: é dele que o compose lê as senhas
# usadas para montar DATABASE_URL e RABBITMQ_URL.
#
# NUNCA comite o `.env.prod` (já está no .gitignore). Este arquivo de exemplo
# não deve conter nenhum valor real.
# ---------------------------------------------------------------------------

# ===========================================================================
# DOMÍNIO E PROXY REVERSO (Traefik v3)
# ===========================================================================
# Domínio onde a API do WhatsApp responderá com SSL automático (ex: whatsapp.seudominio.com.br)
WHATSAPP_API_DOMAIN=whatsapp.seudominio.com.br
# Identificador único do router no Traefik (permite rodar múltiplos whatsapp_api na mesma VPS)
TRAEFIK_ROUTER_NAME=whatsapp_api

# Define ambiente
# Em produção mantenha `production`: isso desabilita o Swagger em /api/docs.
NODE_ENV=production

# Porta de execução da API dentro do container
# Se alterar, ajuste também o mapeamento de portas do serviço `api` no compose.
PORT=5003

# Chave interna para autenticação de requisições de clientes da API (Authorization: Bearer <API_KEY>)
# Gere uma chave longa e segura, ex.: openssl rand -hex 32
API_KEY=

# Senhas da infraestrutura (usadas pelo docker-compose.prod.yml)
# Gere senhas longas e aleatórias, ex.: openssl rand -hex 24
# Atenção: só são aplicadas na PRIMEIRA subida, quando os volumes são criados.
# Para trocar depois, altere a senha dentro do container (ALTER USER /
# rabbitmqctl change_password) ou recrie o volume.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# DATABASE_URL, RABBITMQ_URL e FFMPEG_API_URL não vão aqui: o compose os define
# apontando para os containers da stack (postgres, rabbitmq, ffmpeg-api).

# Versão utilizada da WhatsApp Cloud API (normalmente v25.0)
CLOUD_API_VERSION=v25.0

# Token permanente de acesso do APP META (App Secret)
TOKEN_APP_META=

# ID do Aplicativo META
META_APP_ID=

# ID de configuração do fluxo Embedded Signup
META_CONFIGURATION_ID=

# Token que deve ser cadastrado no app meta para envio de requisições para webhook
# Valor livre: gere um segredo e informe o MESMO valor no campo "Verify Token"
# da configuração de webhook do app na Meta.
APP_META_WEBHOOK_VERIFY_TOKEN=

# Webhook para aplicação do cliente
# URL (HTTPS) que receberá os eventos repassados por esta API e o segredo usado
# para assinar o payload (HMAC-SHA256). O cliente valida a assinatura com ele.
CLIENT_WEBHOOK_URL=
CLIENT_WEBHOOK_SECRET=

# Timeout (ms) do envio para o webhook do cliente
CLIENT_WEBHOOK_TIMEOUT_MS=15000

# Timeout (ms) do envio para os webhooks de desenvolvimento (tabela WebhookClientsDev)
# A instância de produção replica os eventos para as URLs cadastradas nessa
# tabela (tunnels dos ambientes locais do time). O envio é best-effort.
DEV_WEBHOOK_TIMEOUT_MS=5000

# Define se o base64 de mensagens de mídia (audio/vídeo/imagem/etc) retornam o base64
# `true` aumenta bastante o tamanho do payload enviado ao webhook do cliente.
RETURN_MEDIA_BASE64=true

# Limita o processamento de webhooks para os números de telefone listados, separados por vírgula (apenas em NODE_ENV=development)
ALLOWED_NUMBERS=
