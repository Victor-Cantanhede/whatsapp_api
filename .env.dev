# Define ambiente
NODE_ENV=development

# Porta de execução da API
PORT=5003

# Versão utilizada da WhatsApp Cloud API (normalmente v25.0)
CLOUD_API_VERSION=v25.0

# API DATABASE CONNECTION
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/whatsapp_api?schema=public"

# Token permanente de acesso do APP META
TOKEN_APP_META=

# ID do Aplicativo META
META_APP_ID=

# Token que deve ser cadastrado no app meta para envio de requisições para webhook
APP_META_WEBHOOK_VERIFY_TOKEN=

# Webhook para aplicação do cliente
CLIENT_WEBHOOK_URL=
CLIENT_WEBHOOK_SECRET=